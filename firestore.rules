rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Orders: Public can create, read, and update for real-time customer and admin order sync
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // 2. Products and Menu Items: Public read and write for real-time catalog management
    match /products/{productId} {
      allow read, write: if true;
    }
    match /menu_items/{itemId} {
      allow read, write: if true;
    }
    match /custom_images/{imageId} {
      allow read, write: if true;
    }
    match /posters/{posterId} {
      allow read, write: if true;
    }

    // 3. Fallback: Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}


